<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\..\FrameXML\UI.xsd">

	<!-- Aura Template (the 16 buff and 16 debuff buttons are created from it in Core.lua, same anchors as before) -->
	<Button name="ArcHUDAuraTemplate" virtual="true">
		<Size>
			<AbsDimension x="16" y="16"/>
		</Size>
		<Layers>
			<Layer level="ARTWORK">
				<Texture name="$parentIcon" parentKey="Icon" setAllPoints="true"/>
			</Layer>
			<Layer level="OVERLAY">
				<Texture name="$parentBorder" parentKey="Border" file="Interface\Buttons\UI-Debuff-Overlays" hidden="true">
					<Size>
						<AbsDimension x="17" y="17"/>
					</Size>
					<Anchors>
						<Anchor point="CENTER">
							<Offset>
								<AbsDimension x="0" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
					<TexCoords left="0.296875" right="0.5703125" top="0" bottom="0.515625"/>
				</Texture>
				<FontString name="$parentCount" parentKey="Count" inherits="NumberFontNormalSmall">
					<Anchors>
						<Anchor point="BOTTOMRIGHT">
							<Offset>
								<AbsDimension x="-1" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad>
				self.Icon:SetTexture("Interface\\Icons\\INV_Misc_Ear_Human_02");
			</OnLoad>
			<OnEnter>
				ArcHUD:SetAuraTooltip(self);
			</OnEnter>
			<OnLeave>
				GameTooltip:Hide();
			</OnLeave>
		</Scripts>
	</Button>

	<!-- Same look as ArcHUDAuraTemplate, for Blizzard's AuraContainer (used while target auras are
	     restricted in combat; Blizzard fills icon, count and border, addon code never reads the auras).
	     AuraContainer creates AuraButton frames, so this template is an AuraButton too. -->
	<AuraButton name="ArcHUDContainerAuraTemplate" virtual="true">
		<Size x="16" y="16"/>
		<Layers>
			<Layer level="ARTWORK">
				<Texture parentKey="Icon" setAllPoints="true"/>
			</Layer>
			<Layer level="OVERLAY">
				<Texture parentKey="Border" file="Interface\Buttons\UI-Debuff-Overlays" hidden="true">
					<Size x="17" y="17"/>
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
					<TexCoords left="0.296875" right="0.5703125" top="0" bottom="0.515625"/>
				</Texture>
				<FontString parentKey="Count" inherits="NumberFontNormalSmall">
					<Anchors>
						<Anchor point="BOTTOMRIGHT" x="-1" y="0"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
	</AuraButton>

	<!-- Slider row used inside the /archud config menu (replaces Dewdrop's slider popout) -->
	<Frame name="ArcHUDMenuSliderTemplate" virtual="true">
		<Size x="240" y="46"/>
		<Layers>
			<Layer level="OVERLAY">
				<FontString parentKey="Label" inherits="GameFontNormalSmall" justifyH="LEFT">
					<Anchors>
						<Anchor point="TOPLEFT" x="10" y="-2"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<Frame parentKey="SliderControl" inherits="MinimalSliderWithSteppersTemplate">
				<Size x="230" y="28"/>
				<Anchors>
					<Anchor point="BOTTOMLEFT" x="0" y="0"/>
				</Anchors>
			</Frame>
		</Frames>
	</Frame>

